# ── LLM (학교 HAI 게이트웨이, OpenAI 호환) ──────────────────────────
HAI_API_KEY=여기에_발급받은_키
HAI_BASE_URL=https://factchat-cloud.mindlogic.ai/v1/gateway
# 게이트웨이의 모델 목록에서 고른 이름. 도구 호출(function calling)을 지원하는 모델이어야 한다.
HAI_MODEL=claude-sonnet-4-6
# 일부 모델은 temperature 를 받지 않는다. 필요할 때만 주석을 푼다.
# HAI_TEMPERATURE=0

# ── 데이터 ────────────────────────────────────────────────────────
# 지금은 xlsx 를 변환한 테스트 DB. 실제 DB 가 준비되면 이 경로만 바꾼다.
EMR_DB_PATH=support/test/test.sqlite
CONSULT_DB_PATH=support/consults.sqlite
CHECKPOINT_DB_PATH=support/checkpoints.sqlite

# ── 메일 ──────────────────────────────────────────────────────────
# true 면 실제로 보내지 않고 내용만 출력한다. 처음에는 true 로 둔다.
MAIL_DRY_RUN=true
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USER=발신용_지메일_주소
# 지메일 2단계 인증을 켠 뒤 발급받은 "앱 비밀번호" (일반 비밀번호 아님)
MAIL_PASSWORD=
# 수신 교수 주소를 따로 정하지 않았을 때 받는 주소 (팀원 주소)
MAIL_TO_DEFAULT=

# React 개발 서버 주소
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
